import java.util.Scanner;

public class T1_C2_Notas {

    static double promedio(double a, double b, double c) {
        return (a + b + c) / 3.0;
    }

    static String estado(double nota) {
        if (nota >= 14) {
            return "Aprobado";
        } else if (nota >= 9) {
            return "Supletorio";
        } else {
            return "Reprobado";
        }
    }

    static double necesitaEnSupletorio(double nota) {
        return 28 - nota;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Primera nota: ");
        double a = sc.nextDouble();

        System.out.print("Segunda nota: ");
        double b = sc.nextDouble();

        System.out.print("Tercera nota: ");
        double c = sc.nextDouble();

        double n = promedio(a, b, c);

        System.out.printf("Promedio: %.2f%n", n);
        System.out.println("Estado: " + estado(n));

        if (n >= 9 && n < 14) {
            System.out.printf(
                "Necesita en supletorio: %.2f%n",
                necesitaEnSupletorio(n)
            );
        }

        sc.close();
    }
}
