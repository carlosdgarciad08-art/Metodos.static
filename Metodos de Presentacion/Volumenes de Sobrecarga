import java.util.Scanner;

public class T1_C3_Geometria {

    static double volumen(double lado) {
        return lado * lado * lado;
    }

    static double volumen(double radio, double altura) {
        return Math.PI * radio * radio * altura;
    }

    static double volumen(double largo, double ancho, double altura) {
        return largo * ancho * altura;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int opcion;

        do {
            System.out.println("\n1. Cubo");
            System.out.println("2. Cilindro");
            System.out.println("3. Prisma rectangular");
            System.out.println("4. Salir");
            System.out.print("Opcion: ");

            opcion = sc.nextInt();

            switch (opcion) {

                case 1:
                    System.out.print("Lado: ");
                    double lado = sc.nextDouble();

                    System.out.printf(
                        "Volumen: %.2f%n",
                        volumen(lado)
                    );
                    break;

                case 2:
                    System.out.print("Radio: ");
                    double radio = sc.nextDouble();

                    System.out.print("Altura: ");
                    double h = sc.nextDouble();

                    System.out.printf(
                        "Volumen: %.2f%n",
                        volumen(radio, h)
                    );
                    break;

                case 3:
                    System.out.print("Largo: ");
                    double l = sc.nextDouble();

                    System.out.print("Ancho: ");
                    double a = sc.nextDouble();

                    System.out.print("Altura: ");
                    double hp = sc.nextDouble();

                    System.out.printf(
                        "Volumen: %.2f%n",
                        volumen(l, a, hp)
                    );
                    break;

                case 4:
                    System.out.println("Fin.");
                    break;

                default:
                    System.out.println("Opcion no valida.");
            }

        } while (opcion != 4);

        sc.close();
    }
}
